@namespace __MYUI_NAMESPACE__

@if (_show)
{
    <div class="fixed inset-0 z-50 flex overflow-hidden">
        @* Backdrop *@
        <div class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm transition-opacity duration-300 @(_isVisible ? "opacity-100" : "opacity-0")" 
             @onclick="HandleBackdropClick"></div>

        @* Sheet Content *@
        <div class="@SideClasses z-50 flex flex-col gap-4 bg-white p-6 shadow-lg dark:border-white/10 dark:bg-slate-950 @Class"
             @attributes="AdditionalAttributes">
            @ChildContent

            <button @onclick="CloseAsync" 
                    class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:pointer-events-none">
                <Blazicon Svg="Lucide.X" class="h-4 w-4" />
                <span class="sr-only">Close</span>
            </button>
        </div>
    </div>
}

@code {
    [CascadingParameter] public string? LayoutClass { get; set; }
}
