@namespace __MYUI_NAMESPACE__
@inject Services.ToastService ToastService
@implements IDisposable

<div class="group pointer-events-auto relative flex w-full mt-4 items-center justify-between space-x-4 overflow-hidden rounded-md border p-6 pr-8 shadow-lg transition-all @(_isClosing ? "animate-toast-out" : "animate-toast-in") @VariantClasses">
    <div class="grid gap-1">
        @if (!string.IsNullOrEmpty(Model.Title))
        {
            <div class="text-sm font-semibold">@Model.Title</div>
        }
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="text-sm opacity-90">@Model.Message</div>
        }
    </div>
    <button @onclick="() => ToastService.Close(Model.Id)"
            class="absolute right-2 top-2 rounded-md p-1 opacity-0 transition-opacity group-hover:opacity-100 hover:bg-black/5 dark:hover:bg-white/5">
        <Blazicon Svg="Lucide.X" class="h-4 w-4" />
    </button>
</div>

@code {
    [Parameter] public Services.ToastModel Model { get; set; } = default!;

    private bool _isClosing;

    protected override void OnInitialized()
    {
        ToastService.OnRequestClose += HandleRequestClose;
    }

    private async void HandleRequestClose(Guid id)
    {
        if (id == Model.Id && !_isClosing)
        {
            _isClosing = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(300); // Match animation duration
            ToastService.Remove(Model.Id);
        }
    }

    public void Dispose()
    {
        ToastService.OnRequestClose -= HandleRequestClose;
    }

    private string VariantClasses => Model.Variant switch
    {
        Services.ToastVariant.Success => "bg-white dark:bg-slate-950 border-green-500/50 text-green-700 dark:text-green-400",
        Services.ToastVariant.Error => "bg-white dark:bg-slate-950 border-red-500/50 text-red-700 dark:text-red-400",
        Services.ToastVariant.Warning => "bg-white dark:bg-slate-950 border-yellow-500/50 text-yellow-700 dark:text-yellow-400",
        Services.ToastVariant.Info => "bg-white dark:bg-slate-950 border-blue-500/50 text-blue-700 dark:text-blue-400",
        _ => "bg-white dark:bg-slate-950 border-slate-200 dark:border-white/10 text-slate-950 dark:text-slate-50"
    };
}
