@namespace __MYUI_NAMESPACE__

@switch (Variant)
{
    case TypographyVariant.H1:
        <h1 @attributes="AdditionalAttributes" class="scroll-m-20 text-4xl font-extrabold tracking-tight lg:text-5xl @Class">@ChildContent</h1>
        break;
    case TypographyVariant.H2:
        <h2 @attributes="AdditionalAttributes" class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0 @Class">@ChildContent</h2>
        break;
    case TypographyVariant.H3:
        <h3 @attributes="AdditionalAttributes" class="scroll-m-20 text-2xl font-semibold tracking-tight @Class">@ChildContent</h3>
        break;
    case TypographyVariant.H4:
        <h4 @attributes="AdditionalAttributes" class="scroll-m-20 text-xl font-semibold tracking-tight @Class">@ChildContent</h4>
        break;
    case TypographyVariant.P:
        <p @attributes="AdditionalAttributes" class="leading-7 [&:not(:first-child)]:mt-6 @Class">@ChildContent</p>
        break;
    case TypographyVariant.Blockquote:
        <blockquote @attributes="AdditionalAttributes" class="mt-6 border-l-2 pl-6 italic @Class">@ChildContent</blockquote>
        break;
    case TypographyVariant.Lead:
        <p @attributes="AdditionalAttributes" class="text-xl text-slate-700 dark:text-slate-400 @Class">@ChildContent</p>
        break;
    case TypographyVariant.Large:
        <div @attributes="AdditionalAttributes" class="text-lg font-semibold @Class">@ChildContent</div>
        break;
    case TypographyVariant.Small:
        <small @attributes="AdditionalAttributes" class="text-sm font-medium leading-none @Class">@ChildContent</small>
        break;
    case TypographyVariant.Muted:
        <p @attributes="AdditionalAttributes" class="text-sm text-slate-500 dark:text-slate-400 @Class">@ChildContent</p>
        break;
    default:
        <p @attributes="AdditionalAttributes" class="@Class">@ChildContent</p>
        break;
}

@code {
    [Parameter] public TypographyVariant Variant { get; set; } = TypographyVariant.P;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    public enum TypographyVariant
    {
        H1, H2, H3, H4, P, Blockquote, Lead, Large, Small, Muted
    }
}
