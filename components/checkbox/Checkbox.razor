@namespace __MYUI_NAMESPACE__
@implements IDisposable

<div class="flex items-center space-x-2 @Class">
    <div class="relative flex items-center">
        <input  type="checkbox" 
               class="@CheckboxClasses"
               checked="@Checked"
               @onchange="HandleChange"
               disabled="@Disabled"
               @attributes="AdditionalAttributes" />
        
        <Blazicon Svg="Lucide.Check" 
                  class="absolute h-3 w-3 text-white dark:text-slate-900 pointer-events-none opacity-0 peer-checked:opacity-100 transition-opacity left-0.5" />
    </div>
    
    @if (!string.IsNullOrEmpty(Label))
    {
        <label  class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-slate-900 dark:text-white">
            @Label
        </label>
    }
</div>

@code {
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<bool>>? CheckedExpression { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [CascadingParameter] private Microsoft.AspNetCore.Components.Forms.EditContext? EditContext { get; set; }
    
    private Microsoft.AspNetCore.Components.Forms.FieldIdentifier _fieldIdentifier;
    private bool _hasError => EditContext?.GetValidationMessages(_fieldIdentifier).Any() ?? false;

    protected override void OnInitialized()
    {
        if (CheckedExpression != null)
        {
            _fieldIdentifier = Microsoft.AspNetCore.Components.Forms.FieldIdentifier.Create(CheckedExpression);
        }

        if (EditContext != null)
        {
            EditContext.OnValidationStateChanged += HandleValidationStateChanged;
        }
    }

    private void HandleValidationStateChanged(object? sender, Microsoft.AspNetCore.Components.Forms.ValidationStateChangedEventArgs e)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        if (EditContext != null)
        {
            EditContext.OnValidationStateChanged -= HandleValidationStateChanged;
        }
    }

    private string CheckboxClasses => new CssBuilder("peer h-4 w-4 shrink-0 rounded border ring-offset-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-950 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 appearance-none checked:bg-actionPrimary dark:checked:bg-slate-50 transition-colors")
        .AddClass("border-slate-200 dark:border-slate-800", !_hasError)
        .AddClass("border-red-500", _hasError)
        .AddClass("dark:ring-offset-slate-950 dark:focus-visible:ring-slate-300")
        .Build();

    private async Task HandleChange(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        Checked = (bool)(e.Value ?? false);
        await CheckedChanged.InvokeAsync(Checked);

        if (EditContext != null && CheckedExpression != null)
        {
            EditContext.NotifyFieldChanged(_fieldIdentifier);
        }
    }
}
