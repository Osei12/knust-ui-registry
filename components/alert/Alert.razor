 @namespace __MYUI_NAMESPACE__
@if (IsVisible)
{

    <div role="alert"
        class="@($"{GetAlertClasses()} {(_isFadingOut ? "opacity-0 translate-y-[-10px]" : "opacity-100 translate-y-0")}")"
        @attributes="AdditionalAttributes" style="transition: all 300ms ease-in-out;">
        @if (Icon is not null)
        {
            <div class="flex-shrink-0 p-0 m-0">
                @Icon
            </div>
        }

        <div class="flex-1 min-w-0 flex flex-row items-start gap-3 pr-8">
            @if (!string.IsNullOrEmpty(AlertTitle))
            {
                <span class="font-medium text-base leading-tight truncate">
                    @AlertTitle
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="text-sm font-normal truncate">
                    @Description
                </p>
            }
        </div>
        @* <div class="flex items-center gap-2">
            <h4 class="font-medium text-base m-0 p-0 leading-none tracking-normal mt-1">@(!string.IsNullOrEmpty(AlertTitle) ?
                            AlertTitle :
                            "")</h4>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="text-sm ">@Description</p>
            }
        </div> *@

        @if (Dissmisible)
        {
            <button type="button" class="absolute top-2 right-2 p-1 text-gray-500 hover:text-gray-700 transition duration-300"
                @onclick="Dismiss">
                <Blazicon Svg="Lucide.X" />
            </button>
        }
    </div>
}