@namespace __MYUI_NAMESPACE__

<div @attributes="AdditionalAttributes" class="@PositionClasses @Class">
    @ChildContent
</div>

@code {
    protected string PositionClasses => Side switch
    {
        "top" => "absolute bottom-full left-1/2 -translate-x-1/2 mb-2 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200 z-50 overflow-hidden rounded-md border bg-white px-3 py-1.5 text-sm text-slate-950 shadow-md dark:border-white/10 dark:bg-slate-950 dark:text-slate-50 whitespace-nowrap ",
        "bottom" => "absolute top-full left-1/2 -translate-x-1/2 mt-2 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200 z-50 overflow-hidden rounded-md border bg-white px-3 py-1.5 text-sm text-slate-950 shadow-md dark:border-white/10 dark:bg-slate-950 dark:text-slate-50 whitespace-nowrap ",
        "left" => "absolute right-full top-1/2 -translate-y-1/2 mr-2 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200 z-50 overflow-hidden rounded-md border bg-white px-3 py-1.5 text-sm text-slate-950 shadow-md dark:border-white/10 dark:bg-slate-950 dark:text-slate-50 whitespace-nowrap ",
        "right" => "absolute left-full top-1/2 -translate-y-1/2 ml-2 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200 z-50 overflow-hidden rounded-md border bg-white px-3 py-1.5 text-sm text-slate-950 shadow-md dark:border-white/10 dark:bg-slate-950 dark:text-slate-50 whitespace-nowrap ",
        _ => "invisible"
    };
}
