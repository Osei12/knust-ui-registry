@namespace __MYUI_NAMESPACE__

@if (_show)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 overflow-hidden @(_isVisible ? "opacity-100" : "opacity-0") transition-opacity duration-300">
        @* Backdrop *@
        <div class="fixed inset-0  bg-slate-950/80 backdrop-blur-sm" 
             @onclick="HandleBackdropClick"></div>

        @* Modal Content *@
        <div class="relative z-[999] flex flex-col w-full max-w-lg max-h-[85vh] sm:max-h-[90vh] overflow-hidden border border-slate-200 bg-white shadow-lg rounded-2xl dark:border-white/10 dark:bg-slate-950 transition-all duration-300 ease-out @Class @(_isVisible ? "scale-100 opacity-100" : "scale-95 opacity-0")"
             @attributes="AdditionalAttributes">

            @if (!string.IsNullOrEmpty(Title))
            {
                <div class="flex-shrink-0 px-6 pt-6 pb-4 border-b border-slate-100 dark:border-white/10 pr-12">
                    <h2 class="text-lg font-semibold leading-none tracking-tight">@Title</h2>
                    @if (!string.IsNullOrEmpty(Description))
                    {
                        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1.5">@Description</p>
                    }
                </div>
            }

            <div class="flex-1 overflow-y-auto px-6 pb-6 @(string.IsNullOrEmpty(Title) ? "pt-0" : "pt-6") min-h-0">
                @ChildContent
            </div>

            <button @onclick="CloseAsync" 
                    class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:pointer-events-none z-20">
                <Blazicon Svg="Lucide.X" class="h-4 w-4" />
                <span class="sr-only">Close</span>
            </button>
        </div>
    </div>
}
